<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="BDD Test Report - ${it.run.displayName}" norefresh="true">
        <st:include page="sidepanel.jelly" it="${it.run}" />
        <l:main-panel>
            <!-- Include plugin stylesheets and fonts -->
            <link rel="stylesheet" href="${resURL}/plugin/bdd-report-plugin/css/report-styles.css" />

            <!-- Main App Wrapper -->
            <div id="bdd-report-root"
                 class="bdd-app"
                 data-report-url="${rootURL}/${it.run.url}${it.urlName}/reportData"
                 data-attachment-url="${rootURL}/${it.run.url}${it.urlName}/attachment"
                 data-download-url="${rootURL}/${it.run.url}${it.urlName}/downloadReport"
                 data-build-name="${it.run.displayName}"
                 data-build-url="${rootURL}/${it.run.url}">

                <!-- App Header -->
                <header class="bdd-header">
                    <div class="bdd-header-left">
                        <div class="bdd-brand-badge">
                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>BDD Report</span>
                        </div>
                        <h1 class="bdd-build-title">
                            <a href="${rootURL}/${it.run.url}">${it.run.displayName}</a>
                        </h1>
                    </div>

                    <div class="bdd-header-actions">
                        <button id="theme-toggle-btn" class="bdd-btn bdd-btn-icon" title="Toggle Light / Dark Mode">
                            <svg class="bdd-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                <line x1="1" y1="12" x2="3" y2="12"></line>
                                <line x1="21" y1="12" x2="23" y2="12"></line>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                            </svg>
                            <svg class="bdd-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                            </svg>
                        </button>
                        <a id="download-json-btn" href="${rootURL}/${it.run.url}${it.urlName}/downloadReport" class="bdd-btn" download="cucumber-report.json" title="Export JSON Report">
                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            <span>Export</span>
                        </a>
                        <button id="fullscreen-toggle-btn" class="bdd-btn bdd-btn-icon" title="Toggle Fullscreen">
                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <polyline points="9 21 3 21 3 15"></polyline>
                                <line x1="21" y1="3" x2="14" y2="10"></line>
                                <line x1="3" y1="21" x2="10" y2="14"></line>
                            </svg>
                        </button>
                    </div>
                </header>

                <!-- Loading Spinner -->
                <div id="bdd-loading-state" class="bdd-loading-state">
                    <div class="bdd-spinner"></div>
                    <p style="color:var(--bdd-text-muted);font-size:0.75rem;">Loading and analyzing BDD execution report...</p>
                </div>

                <!-- Error State -->
                <div id="bdd-error-state" class="bdd-error-state" style="display:none;">
                    <h3 style="font-size:0.875rem;margin:0 0 0.25rem 0;">Failed to load report data</h3>
                    <p id="bdd-error-message" style="font-size:0.75rem;margin:0;">Unknown error occurred.</p>
                </div>

                <!-- Main Report Content (Loaded via JS) -->
                <div id="bdd-content-area" style="display:none;">
                    <!-- Executive KPI Summary Cards -->
                    <section class="bdd-summary-grid">
                        <div class="bdd-metric-card bdd-card-total">
                            <div class="metric-meta">
                                <span class="metric-label">Total Scenarios</span>
                                <span class="metric-rate-badge rate-warning" id="metric-pass-rate">0% Pass Rate</span>
                            </div>
                            <div class="metric-value-row">
                                <span class="metric-value" id="metric-total-scenarios">0</span>
                            </div>
                            <div class="metric-progress-bar">
                                <div id="progress-passed-bar" class="progress-segment passed" style="width: 0%"></div>
                                <div id="progress-failed-bar" class="progress-segment failed" style="width: 0%"></div>
                                <div id="progress-skipped-bar" class="progress-segment skipped" style="width: 0%"></div>
                            </div>
                        </div>

                        <div class="bdd-metric-card bdd-card-passed">
                            <div class="metric-meta">
                                <span class="metric-label">Passed</span>
                            </div>
                            <div class="metric-value-row">
                                <span class="metric-value text-passed" id="metric-passed-scenarios">0</span>
                            </div>
                            <div class="metric-sub" id="metric-passed-steps">0 steps</div>
                        </div>

                        <div class="bdd-metric-card bdd-card-failed">
                            <div class="metric-meta">
                                <span class="metric-label">Failed</span>
                            </div>
                            <div class="metric-value-row">
                                <span class="metric-value text-failed" id="metric-failed-scenarios">0</span>
                            </div>
                            <div class="metric-sub" id="metric-failed-steps">0 steps</div>
                        </div>

                        <div class="bdd-metric-card bdd-card-skipped">
                            <div class="metric-meta">
                                <span class="metric-label">Skipped</span>
                            </div>
                            <div class="metric-value-row">
                                <span class="metric-value text-skipped" id="metric-skipped-scenarios">0</span>
                            </div>
                            <div class="metric-sub" id="metric-skipped-steps">0 steps</div>
                        </div>

                        <div class="bdd-metric-card bdd-card-duration">
                            <div class="metric-meta">
                                <span class="metric-label">Total Duration</span>
                            </div>
                            <div class="metric-value-row">
                                <span class="metric-value text-duration" id="metric-total-duration">0s</span>
                            </div>
                            <div class="metric-sub" id="metric-total-features">0 features</div>
                        </div>
                    </section>

                    <!-- View Navigation Tabs -->
                    <nav class="bdd-tabs-nav">
                        <button class="bdd-tab-btn active" data-tab="scenarios-tab">
                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 6h16M4 12h16M4 18h7" />
                            </svg>
                            <span>Scenarios</span>
                        </button>
                        <button class="bdd-tab-btn" data-tab="attachments-tab">
                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                            </svg>
                            <span>Attachments</span>
                            <span class="bdd-badge" id="attachments-count-badge">0</span>
                        </button>
                    </nav>

                    <!-- Tab 1: Scenarios View -->
                    <section id="scenarios-tab" class="bdd-tab-pane active">
                        <!-- Toolbar (Search, Segmented Filter, Compact Tag Popover, Icon Tree Controls) -->
                        <div class="bdd-toolbar">
                            <div class="bdd-toolbar-left">
                                <div class="bdd-search-box">
                                    <svg class="bdd-icon search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="11" cy="11" r="8" />
                                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                    </svg>
                                    <input type="text" id="bdd-search-input" placeholder="Search features, scenarios, steps, errors, tags... (/)" />
                                    <button id="bdd-search-clear" class="bdd-search-clear" style="display:none;" title="Clear search">
                                        <svg class="bdd-icon bdd-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </div>

                                <!-- Segmented Status Filter Control -->
                                <div class="bdd-segmented-control">
                                    <button class="bdd-filter-btn active" data-filter="all" title="Show all scenarios">
                                        <span class="status-dot dot-all"></span>
                                        <span>All</span>
                                        <span class="filter-count" id="filter-count-all">0</span>
                                    </button>
                                    <button class="bdd-filter-btn" data-filter="failed" title="Filter failed scenarios">
                                        <span class="status-dot dot-failed"></span>
                                        <span>Failed</span>
                                        <span class="filter-count" id="filter-count-failed">0</span>
                                    </button>
                                    <button class="bdd-filter-btn" data-filter="passed" title="Filter passed scenarios">
                                        <span class="status-dot dot-passed"></span>
                                        <span>Passed</span>
                                        <span class="filter-count" id="filter-count-passed">0</span>
                                    </button>
                                    <button class="bdd-filter-btn" data-filter="skipped" title="Filter skipped scenarios">
                                        <span class="status-dot dot-skipped"></span>
                                        <span>Skipped</span>
                                        <span class="filter-count" id="filter-count-skipped">0</span>
                                    </button>
                                </div>
                            </div>

                            <div class="bdd-toolbar-right">
                                <!-- Compact Tag Filter Dropdown -->
                                <div class="bdd-tag-control-wrapper">
                                    <button id="bdd-tag-dropdown-btn" class="bdd-tag-dropdown-btn" title="Filter by Scenario Tags">
                                        <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                            <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                        </svg>
                                        <span>Tags</span>
                                        <span class="tag-count-badge">0</span>
                                        <svg class="bdd-icon bdd-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </button>
                                    <div id="bdd-tag-popover" class="bdd-tag-popover">
                                        <div class="tag-popover-header">
                                            <svg class="bdd-icon tag-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" id="tag-popover-search" class="tag-popover-search" placeholder="Filter tags..." />
                                        </div>
                                        <div class="tag-popover-actions">
                                            <a class="tag-action-link" id="tag-select-all-btn">Select All</a>
                                            <a class="tag-action-link" id="tag-clear-all-btn">Clear All</a>
                                        </div>
                                        <div id="tag-popover-list" class="tag-popover-list">
                                            <!-- Rendered dynamically -->
                                        </div>
                                    </div>
                                </div>

                                <button id="expand-all-btn" class="bdd-btn bdd-btn-icon" title="Expand All Scenarios">
                                    <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="7 13 12 18 17 13"></polyline>
                                        <polyline points="7 6 12 11 17 6"></polyline>
                                    </svg>
                                </button>
                                <button id="collapse-all-btn" class="bdd-btn bdd-btn-icon" title="Collapse All Scenarios">
                                    <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="17 11 12 6 7 11"></polyline>
                                        <polyline points="17 18 12 13 7 18"></polyline>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Active Tags Ribbon (Only visible when tags are selected) -->
                        <div id="bdd-active-tags-bar" class="bdd-active-tags-bar">
                            <span class="active-tags-label">Active Tags:</span>
                            <div id="bdd-active-tags-list" style="display:flex;gap:0.35rem;flex-wrap:wrap;"></div>
                            <button id="clear-all-active-tags-btn" class="clear-all-tags-btn">Clear all</button>
                        </div>

                        <!-- Features & Scenarios Tree List -->
                        <div id="bdd-features-container" class="bdd-features-container">
                            <!-- Populated dynamically by report-app.js -->
                        </div>
                    </section>

                    <!-- Tab 2: Debug & Attachments Explorer -->
                    <section id="attachments-tab" class="bdd-tab-pane">
                        <div class="bdd-explorer-layout">
                            <!-- Left Sidebar Tree -->
                            <aside class="bdd-explorer-tree-panel">
                                <div class="explorer-panel-header">
                                    <h3>Attachments</h3>
                                    <input type="text" id="explorer-search-input" class="explorer-search-input" placeholder="Filter attachments..." />
                                </div>
                                <div id="explorer-tree-content" class="explorer-tree-content">
                                    <!-- Populated dynamically -->
                                </div>
                            </aside>

                            <!-- Right Content Viewer Pane -->
                            <main class="bdd-explorer-viewer-panel">
                                <div class="viewer-header">
                                    <div>
                                        <div id="viewer-attachment-title" class="viewer-attachment-title">Select an attachment to view</div>
                                        <div id="viewer-attachment-details" class="viewer-attachment-details"></div>
                                    </div>
                                    <div class="viewer-actions" id="viewer-actions" style="display:none;gap:0.4rem;">
                                        <button id="viewer-copy-btn" class="bdd-btn">
                                            <svg class="bdd-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                            </svg>
                                            <span>Copy</span>
                                        </button>
                                    </div>
                                </div>
                                <div id="viewer-content-body" class="viewer-content-body">
                                    <div class="viewer-placeholder">
                                        <p>Select any attachment from the left explorer tree to inspect image previews or copy log traces.</p>
                                    </div>
                                </div>
                            </main>
                        </div>
                    </section>
                </div>

                <!-- Toast Notification Container -->
                <div id="bdd-toast" class="bdd-toast" style="display:none;"></div>
            </div>

            <!-- Include plugin JavaScript application -->
            <script src="${resURL}/plugin/bdd-report-plugin/js/report-app.js"></script>
        </l:main-panel>
    </l:layout>
</j:jelly>
