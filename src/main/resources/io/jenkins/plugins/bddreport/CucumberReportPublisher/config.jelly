<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <f:entry title="${%Cucumber JSON Path Pattern}" field="jsonReportPath"
             description="${%Ant-style file pattern relative to the workspace, e.g., **/cucumber.json or target/cucumber-report*.json}">
        <f:textbox default="**/cucumber.json"/>
    </f:entry>

    <f:advanced title="${%Advanced Storage &amp; Execution Settings}">
        <f:entry title="${%Embed Full Attachments}" field="embedFullAttachments"
                 description="${%If checked, embeds all attachment data directly into the DOM instead of externalizing large fragments to disk.}">
            <f:checkbox default="false"/>
        </f:entry>

        <f:entry title="${%Large Attachment Threshold (KB)}" field="attachmentThresholdKB"
                 description="${%Attachments larger than this threshold (in KB) are stored as external fragment files to prevent Jenkins memory and disk bloat.}">
            <f:number default="500"/>
        </f:entry>

        <f:entry title="${%Fail Build on Test Failure}" field="failBuildOnTestFailure"
                 description="${%Mark the Jenkins build status as FAILURE if any scenario fails.}">
            <f:checkbox default="false"/>
        </f:entry>

        <f:entry title="${%Ignore Missing Reports}" field="ignoreMissingReports"
                 description="${%Do not fail or warn if no Cucumber JSON files are found matching the pattern.}">
            <f:checkbox default="false"/>
        </f:entry>
    </f:advanced>
</j:jelly>
